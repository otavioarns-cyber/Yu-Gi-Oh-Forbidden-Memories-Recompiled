  "enabled": true,
  "restart": true,
  "settings": [
    {
      "key": "expansion_enabled",
      "label": "Expansion — 27 ritual duelists (Isis Vanilla)",
      "type": "bool",
      "default": 1,
      "restart": true
    },
    {
      "key": "guaranteed_package_free",
      "label": "Guaranteed Ritual Package in Free Duel",
      "type": "bool",
      "default": 0,
      "description": "Guarantees at least one complete Ritual Package in Free Duel, matching Story Mode behavior. Disable for normal weighted selection.",
      "restart": true
    },
    {
      "key": "recipe_source",
      "label": "Deck ritual recipe source",
      "type": "choice",
      "default": 0,
      "choices": [
        "Auto (providers, game tables, Vanilla)",
        "Force Vanilla",
        "Force configured Ritual Effects recipe"
      ],
      "description": "Auto reads v0.3.0 official 1-5 tribute rules, classic game tables and available providers. Only the active game/ritual mod performs a summon. Manual fallbacks are optional.",
      "restart": true
    },
    {
      "key": "ai_planner",
      "label": "Ritual Duelists — Ritual Planner",
      "type": "bool",
      "default": 1
    },
    {
      "key": "diagnostics",
      "label": "Log diagnostic events",
      "type": "bool",
      "default": 1,
      "description": "Logs significant AI decisions with origin, reasons, physical/logical Ritual Magic position and whether legality was actually checked. May increase log size during long tests."
    },
    {
      "key": "debug_overlay",
      "label": "Ritual Duelists diagnostic overlay",
      "type": "choice",
      "default": 1,
      "choices": [
        "Off",
        "Compact",
        "Detailed"
      ],
      "description": "Read-only test panel: recipe, deck, physical/logical Ritual Magic, reason and source of decisions, last significant request. No extra Ritual legality probes per frame."
    }
  ],
